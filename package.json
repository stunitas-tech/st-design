{
    "name": "@conects-design/project",
    "scripts": {
        "install:root": "bun install",
        "install:docs": "bun install --cwd docs",
        "docs:pull": "git checkout main && git pull origin HEAD",
        "docs:install": "bun run install:root && bun run install:docs",
        "docs:dev": "bun run docs:pull && bun run docs:install && bun --cwd docs dev",
        "docs:push": "bun run ./scripts/docs-push.ts",
        "figma:sync": "bun install && bun run ./scripts/figma-registry.ts"
    },
    "version": "0.0.0",
    "private": true,
    "devDependencies": {
        "@types/node": "^25.0.3"
    },
    "dependencies": {
        "@figma/rest-api-spec": "^0.35.0",
        "figma-api": "^2.1.0-beta",
        "lucide-react": "^0.563.0"
    }
}
