{
    "name": "@st-design/react",
    "version": "1.0.8",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/stunitas-tech/st-design",
        "directory": "packages/react"
    },
    "sideEffects": [
        "*.css"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.js",
            "require": "./lib/index.cjs"
        },
        "./primitive": {
            "types": "./lib/primitive.d.ts",
            "import": "./lib/primitive.js",
            "require": "./lib/primitive.cjs"
        },
        "./package.json": "./package.json"
    },
    "main": "./lib/index.cjs",
    "types": "./lib/index.d.ts",
    "files": [
        "lib",
        "src"
    ],
    "scripts": {
        "clean": "rm -rf lib",
        "build": "vite build",
        "lint:publish": "bun publint"
    },
    "dependencies": {
        "@radix-ui/react-compose-refs": "^1.1.2",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-use-controllable-state": "1.2.2",
        "@radix-ui/react-use-layout-effect": "^1.1.1",
        "clsx": "^2.1.1",
        "unicode-segmenter": "^0.14.4"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.1",
        "@vitejs/plugin-react": "^5.0.0",
        "ajv": "^8.17.1",
        "csstype": "^3.1.3",
        "globby": "^16.0.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "vite": "^7.0.0",
        "vite-plugin-dts": "^4.5.4"
    },
    "publishConfig": {
        "access": "public"
    }
}
